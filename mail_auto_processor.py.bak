        self.entry_sent_folder.grid(row=1, column=1, sticky=tk.W, padx=5, pady=3)
        self.entry_sent_folder.insert(0, "Sent")
        ttk.Label(sent_frame, text="(Sent, Отправленные, Sent Items — зависит от сервера)",
