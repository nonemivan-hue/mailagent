                  command=self._get_new_account).pack(side=tk.LEFT, padx=2)
        ttk.Button(btn_frame, text="Дополнительная настройка",
                  command=self._advanced_settings).pack(side=tk.LEFT, padx=2)

        # Правая группа кнопок
